# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
VENDOR_RISK_TIMEOUT_SECONDS=3

# Dataset directory (defaults to ./data). Point at another folder to run against a different snapshot.
# PROCUREMENT_DATA_DIR=

# LLM provider: gemini | groq  (both free-tier, called via their OpenAI-compatible endpoints)
LLM_PROVIDER=gemini
# Leave blank to use the provider default (gemini: gemini-3.8-flash, groq: openai/gpt-oss-120b).
MODEL_NAME=
LLM_TIMEOUT_SECONDS=60
# Thinking depth for reasoning models: low | medium | high (blank = provider default).
LLM_REASONING_EFFORT=low
# Client-side throttle to stay inside free-tier limits (0 = provider default).
LLM_MAX_REQUESTS_PER_MINUTE=0
LLM_MAX_RETRIES=4

# Add only the key for the provider you use. Never commit .env.
# Gemini key: https://aistudio.google.com/apikey   Groq key: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
